# ==============================================================================
# ERNIE-5.5-Flash-Preview on 2x NVIDIA DGX Spark (GB10 SM121, Dual 200GbE RoCEv2)
# Copy this file to `.env` on Node 0 (head node) and adjust values for your pair:
#   cp .env.example .env
# ==============================================================================

# --- 1. Container Image & Naming ---
IMAGE=ernie55-dual-spark:v0.3.0
CONTAINER_NAME=ernie55-dual-spark

# --- 2. Dual DGX Spark High-Speed Fabric (200GbE ConnectX-7 RoCEv2) ---
# Direct-attached or switched 200GbE subnet IPs on Node 0 (Rank 0) and Node 1 (Rank 1)
NODE0_IP=10.42.0.1
NODE1_IP=10.42.0.2
FABRIC_PREFIX_LEN=24

# Passwordless SSH target from Node 0 -> Node 1 (used by scripts to start/check Rank 1)
NODE1_SSH=ubuntu@10.42.0.2

# ConnectX-7 200GbE port selection on DGX Spark:
#   Port 0 cabled -> FABRIC_IFNAME=enp1s0f0np0   | RDMA_HCAS=rocep1s0f0,roceP2p1s0f0
#   Port 1 cabled -> FABRIC_IFNAME=enp1s0f1np1   | RDMA_HCAS=rocep1s0f1,roceP2p1s0f1
# (DGX Spark exposes two PCIe root-complex RoCE devices per physical ConnectX-7 port.
#  If Node 1 is cabled into a different physical port than Node 0, set NODE1_FABRIC_IFNAME / NODE1_RDMA_HCAS.)
FABRIC_IFNAME=enp1s0f0np0
RDMA_HCAS=rocep1s0f0,roceP2p1s0f0
# NODE1_FABRIC_IFNAME=enp1s0f0np0
# NODE1_RDMA_HCAS=rocep1s0f0,roceP2p1s0f0

# RoCEv2 IPv4 GID index (3 is standard on DGX OS / Ubuntu 24.04; verified by check_cluster_prereqs.sh)
NCCL_IB_GID_INDEX=3

# --- 3. Model Weights & Persistent SM121 JIT Cache Paths ---
# Path to `baidu/ERNIE-5.5-Flash-Preview` (~154.5 GiB, 128 safetensors shards + flashindexer/)
MODEL_DIR=/data/models/ERNIE-5.5-Flash-Preview
NODE1_MODEL_DIR=/data/models/ERNIE-5.5-Flash-Preview

# Persistent host cache for SM121 FlashInfer / DeepGEMM / Triton / b12x JIT kernels
# (First cold boot compiles kernels in ~8-12 min; subsequent starts take ~75-95 s)
CACHE_DIR=/var/tmp/vllm-ernie55-sm121
NODE1_CACHE_DIR=/var/tmp/vllm-ernie55-sm121

# --- 4. OpenAI-Compatible Serving & Engine Parameters ---
HOST=0.0.0.0
PORT=8898
MASTER_PORT=50055
SERVED_MODEL_NAME=baidu/ERNIE-5.5-Flash-Preview

# Memory & batching tuned for 2x 128 GiB unified LPDDR5X (~17.14 GiB FP8 KV cache/node + ~6.5 GiB OS headroom)
GPU_MEMORY_UTILIZATION=0.86
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8
MOE_BACKEND=b12x
LOAD_FORMAT=auto

# Speculative Decoding (`DSpark` 3-layer draft + full-vocab fused FP8 Markov + Multimax) & `FlashIndexer`
ENABLE_DSPARK=1
NUM_SPEC_TOKENS=7
DSPARK_DRAFT_TOPK=0
ADAPTIVE_VERIFICATION=0
ENABLE_FLASHINDEXER=1

# --- 5. Optional Build / Download Mirrors & Proxies ---
# Uncomment only if needed during `scripts/build_image.sh` or `scripts/prepare_weights.sh`:
# HF_ENDPOINT=https://hf-mirror.com
# PIP_INDEX_URL=https://pypi.org/simple
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=127.0.0.1,localhost
